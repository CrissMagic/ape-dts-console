# Docker --env-file example. Replace every placeholder before deployment.
# A development process does not load this file automatically.
SCS_PLATFORM_VERSION=1.0.0
SCS_PLATFORM_CONFIG_PATH=/data/storage/.platform/config.json
SCS_PLATFORM_DATABASE_CONFIG={"host":"your-metadata-postgres-host","port":5432,"database":"ape_dts_console","username":"ape_dts_console","password":"replace-with-a-unique-password","tls":{"mode":"DISABLE"}}
SECURITY_ARGON2_MEMORY_KIB=65536
SECURITY_ARGON2_PARALLELISM=2
SECURITY_ARGON2_PASSES=3
SECURITY_ARGON2_TAG_LENGTH=32
SCS_RUNTIME_METRICS_PORT_MIN=36001
SCS_RUNTIME_METRICS_PORT_MAX=36100
